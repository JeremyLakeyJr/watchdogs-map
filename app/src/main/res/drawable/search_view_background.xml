<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced neon-themed background for Watch Dogs 2 aesthetic -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Dark, semi-transparent background for the hacker aesthetic -->
    <solid android:color="#DD000000" />

    <!-- Bright cyan neon stroke (Watch Dogs 2 signature color) -->
    <stroke
        android:width="2dp"
        android:color="#00FFF7" />

    <!-- Rounded corners for modern UI -->
    <corners android:radius="8dp" />

</shape>